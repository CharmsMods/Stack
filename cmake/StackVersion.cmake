set(STACK_VERSION_MAJOR 1)
set(STACK_VERSION_MINOR 2)
set(STACK_VERSION_PATCH 167)
if(DEFINED STACK_VERSION_OVERRIDE AND NOT STACK_VERSION_OVERRIDE STREQUAL "")
    if(NOT STACK_VERSION_OVERRIDE MATCHES "^([0-9]+)\\.([0-9]+)\\.([0-9]+)$")
        message(FATAL_ERROR "STACK_VERSION_OVERRIDE must use major.minor.patch")
    endif()
    set(STACK_VERSION_MAJOR "${CMAKE_MATCH_1}")
    set(STACK_VERSION_MINOR "${CMAKE_MATCH_2}")
    set(STACK_VERSION_PATCH "${CMAKE_MATCH_3}")
endif()
set(STACK_VERSION "${STACK_VERSION_MAJOR}.${STACK_VERSION_MINOR}.${STACK_VERSION_PATCH}")
set(STACK_VERSION_TAG "v${STACK_VERSION}")
set(STACK_PUBLISHER "Darynn Ho")


