# The final-window compositor owns its state. Generate its entry point from
# the same pinned draw loop, retaining texture updates, callbacks, HDR pairing
# and temporary-VAO lifetime without querying/restoring unrelated driver state.
stack_window_color_anchor("GLuint vertex_array_object)\n{" "GLuint vertex_array_object, bool stackOwnedState = false)\n{")
