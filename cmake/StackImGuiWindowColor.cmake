string(FIND "${backend}" "void    ImGui_ImplOpenGL3_RenderDrawData(ImDrawData* draw_data)" owned_start)
string(FIND "${backend}" "    // Backup GL state" owned_backup)
string(FIND "${backend}" "    // Setup desired GL state" owned_setup)
string(FIND "${backend}" "    // Restore modified GL state" owned_restore)
if(owned_start LESS 0 OR owned_backup LESS owned_start OR owned_setup LESS owned_backup OR owned_restore LESS owned_setup)
    message(FATAL_ERROR "Pinned ImGui draw-loop boundaries changed")
endif()
math(EXPR owned_prefix_length "${owned_backup}-${owned_start}")
math(EXPR owned_loop_length "${owned_restore}-${owned_setup}")
string(SUBSTRING "${backend}" ${owned_start} ${owned_prefix_length} owned_prefix)
string(SUBSTRING "${backend}" ${owned_setup} ${owned_loop_length} owned_loop)
string(REPLACE "void    ImGui_ImplOpenGL3_RenderDrawData" "void Stack::Platform::RenderOwnedUiDrawData" owned_prefix "${owned_prefix}")
string(REPLACE "fb_height, vertex_array_object);" "fb_height, vertex_array_object, true);" owned_loop "${owned_loop}")
set(owned_backend "#ifndef IMGUI_DISABLE\n${owned_prefix}    bool stackNativeShader = true;\n    const bool stackPhotoAdapt = Stack::Hdr::Ui::linearTarget && Stack::Hdr::CurrentTargetHeadroom() < Stack::Hdr::MasterHeadroom;\n    int stackPhotoSampler = 0;\n    glActiveTexture(GL_TEXTURE0);\n${owned_loop}}\n#endif\n")
file(CONFIGURE OUTPUT "${STACK_OPENGL_BACKEND_SOURCE}" CONTENT "#include \"Platform/ImGuiWindowColor.h\"\n#include \"Platform/ImGuiRenderer.h\"\n${backend}\n${owned_backend}" @ONLY)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${upstream_backend}")
