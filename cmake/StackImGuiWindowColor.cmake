# Adapt only the desktop GLSL 4.10+ branch of Stack's pinned backend.
set(STACK_OPENGL_BACKEND_SOURCE "${CMAKE_BINARY_DIR}/generated/imgui_impl_opengl3_stack.cpp")
set(upstream_backend "${imgui_SOURCE_DIR}/backends/imgui_impl_opengl3.cpp")
file(READ "${upstream_backend}" backend)
function(stack_window_color_anchor marker replacement)
    string(FIND "${backend}" "${marker}" position)
    if(position EQUAL -1)
        message(FATAL_ERROR "Pinned ImGui OpenGL backend changed at ${marker}")
    endif()
    string(REPLACE "${marker}" "${replacement}" patched "${backend}")
    set(backend "${patched}" PARENT_SCOPE)
endfunction()
stack_window_color_anchor("vertex_shader = vertex_shader_glsl_410_core;" "vertex_shader = Stack::Platform::UiVertexShader.c_str();")
stack_window_color_anchor("fragment_shader = fragment_shader_glsl_410_core;" "fragment_shader = Stack::Platform::UiFragmentShader.c_str();")
stack_window_color_anchor("GLint           AttribLocationTex;" "GLint           AttribLocationLinearTarget;\n    GLint           AttribLocationTex;")
stack_window_color_anchor("bd->AttribLocationTex = glGetUniformLocation" "bd->AttribLocationLinearTarget = glGetUniformLocation(bd->ShaderHandle, \"StackLinearTarget\");\n    bd->AttribLocationTex = glGetUniformLocation")
stack_window_color_anchor("glUniform1i(bd->AttribLocationTex, 0);" "glUniform1i(bd->AttribLocationTex, 0);\n    if (bd->AttribLocationLinearTarget >= 0) glUniform1i(bd->AttribLocationLinearTarget, Stack::Hdr::Ui::linearTarget);")
file(CONFIGURE OUTPUT "${STACK_OPENGL_BACKEND_SOURCE}" CONTENT "#include \"Platform/ImGuiWindowColor.h\"\n${backend}" @ONLY)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${upstream_backend}")
