# Adapt only the desktop GLSL 4.10+ branch of Stack's pinned backend.
set(STACK_OPENGL_BACKEND_SOURCE "${CMAKE_BINARY_DIR}/generated/imgui_impl_opengl3_stack.cpp")
set(upstream_backend "${imgui_SOURCE_DIR}/backends/imgui_impl_opengl3.cpp")
file(READ "${upstream_backend}" backend)
function(stack_window_color_anchor marker replacement)
    string(FIND "${backend}" "${marker}" position)
    if(position EQUAL -1)
        message(FATAL_ERROR "Pinned ImGui OpenGL backend changed at ${marker}")
    endif()
    string(REPLACE "${marker}" "${replacement}" patched "${backend}")
    set(backend "${patched}" PARENT_SCOPE)
endfunction()
